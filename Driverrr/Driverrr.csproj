<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Driverrr</AssemblyName>
    <RootNamespace>Driverrr</RootNamespace>
    <Version>0.3.0</Version>
    <Product>Driverrr</Product>
    <Description>Mantiene al día los drivers del equipo con Windows Update y el Catálogo de Microsoft Update</Description>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- El binario no debe llevar rutas ni nombres del equipo donde se compila -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src/Driverrr</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
